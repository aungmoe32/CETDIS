# ==============================================================================
# CEDIS Showcase Environment Variables (Template / Example)
# Copy this to .env.showcase and populate with your preferred demo emails:
#   cp .env.showcase.example .env.showcase
# ==============================================================================

# Target Organizer for Project Showcase
SHOWCASE_ORGANIZER_EMAIL=organizer@example.com

# Showcase Personas for Live Booth Scenarios
SHOWCASE_STUDENT_CLEAN_SCAN=student1@example.com
SHOWCASE_STUDENT_CLEAN_SCAN_2=student2@example.com
SHOWCASE_STUDENT_ALREADY_SCANNED=student3@example.com
SHOWCASE_STUDENT_NFC_HANDOVER=student4@example.com
SHOWCASE_STUDENT_WALKUP_SALE=student5@example.com
SHOWCASE_STUDENT_WALKUP_PAID=student6@example.com

# Optional student names mapping (JSON map of email -> Full Name)
SHOWCASE_STUDENT_NAMES='{"student1@example.com":"Student One","student2@example.com":"Student Two"}'
